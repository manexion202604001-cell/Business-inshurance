# SQLite (development). For production use PostgreSQL: postgresql://user:pass@host:5432/proposal3
DATABASE_URL="file:./dev.db"
# Session cookie signing secret (change in production)
SESSION_SECRET="change-me-in-production"
# LLM (optional). Without a key the app runs in deterministic template mode.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL_MAIN=claude-sonnet-5
# ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001
# P3_LLM_MODE=auto   # auto | on | off
# P3_MASK_PII=1      # mask e-mail addresses / phone numbers before sending logs to the LLM
# P3_CHROMIUM_PATH=  # Chromium executable for PDF output (Playwright)
